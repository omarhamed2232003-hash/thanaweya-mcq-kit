{
  "name": "thanaweya-mcq-kit",
  "version": "0.28.6",
  "description": "Arabic-first (RTL) multiple-choice quiz engine with original sample content. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "ui",
    "data",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate-data.mjs",
    "serve": "python3 -m http.server 8080",
    "build:demo": "node scripts/build-demo.mjs",
    "build:packet": "node scripts/build-teacher-packet.mjs"
  },
  "keywords": [
    "arabic",
    "rtl",
    "mcq",
    "quiz",
    "education",
    "zero-dependencies"
  ],
  "engines": {
    "node": ">=18"
  }
}
